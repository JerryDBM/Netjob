# Conexión a PostgreSQL. `npm run db:dev` levanta uno local en el puerto 5433.
DATABASE_URL="postgresql://postgres:netjob@localhost:5433/netjob"
# Supabase: DATABASE_URL = pooler de transacciones (puerto 6543, ?pgbouncer=true); DIRECT_URL = pooler de sesión (5432)
DIRECT_URL="postgresql://postgres:netjob@localhost:5433/netjob"
PORT=4000
# Cambiar en producción por un valor largo y aleatorio
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="7d"
# URL pública del backend (para construir URLs de imágenes y redirects)
PUBLIC_URL="http://localhost:4000"
# URL a la que Wompi redirige al terminar el pago (pantalla de la app/web)
PAYMENT_REDIRECT_URL="http://localhost:4000/payments/return"

# Modelo económico
COMMISSION_RATE=0.03
SUBSCRIPTION_DAYS=30
# Póliza de visita/diagnóstico que paga el cliente (COP, sin comisión)
# Costo por defecto de la visita para profesionales nuevos y tope máximo que pueden fijar
DIAGNOSTIC_FEE=8000
MAX_DIAGNOSTIC_FEE=35000
# Radio máximo de búsqueda alrededor del cliente (km)
SEARCH_RADIUS_KM=12
# Fotos mínimas de portafolio para completar el perfil profesional
MIN_PORTFOLIO=2

# Wompi (sandbox). Llaves en https://comercios.wompi.co → Desarrolladores
WOMPI_ENV="sandbox"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
# true = sin llaves de Wompi se permite simular pagos (solo desarrollo)
PAYMENTS_MOCK=true

# Servidor de rutas (OSRM) para la navegación del profesional dentro de la app
ROUTING_URL=https://router.project-osrm.org

# Fidelización y premios
LOYALTY_COMMISSION_RATE=0.01
LOYALTY_EVERY=3
LOYALTY_MIN_RATING=4.4
PRO_REWARD_MIN_RATING=4.8
# Garantía de la mano de obra (días) y soporte
WARRANTY_DAYS=30
SUPPORT_WHATSAPP=573027402932
# Verificación de identidad obligatoria para aparecer en búsquedas y recibir solicitudes.
# false = la insignia de verificado pasa a ser opcional
REQUIRE_VERIFICATION=true

# Supabase Storage para las imágenes (opcional en desarrollo: sin esto se guardan en uploads/).
# Supabase → Project Settings → API. La llave service_role es secreta: solo en el backend.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="uploads"
SUPABASE_PRIVATE_BUCKET="private-docs"
